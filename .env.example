# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://almaskaanvillage.com

# --- Inquiry form delivery (SMTP). The form returns an honest error until these are set. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Who receives inquiries, and the From address (must be allowed by your SMTP provider)
INQUIRY_TO=operations@almaskaanvillage.com
INQUIRY_FROM=

# --- Visitor counter (footer "visitors since launch"). Hidden until set. ---
# Added automatically when an Upstash Redis store is connected to the project in Vercel (Storage → Upstash → Connect).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Site assistant (chat bubble, bottom-left). Without a key it still answers from built-in topics. ---
# Create a key at platform.claude.com → API keys. Model: Claude Opus 5.5 (see src/app/api/chat/route.ts).
ANTHROPIC_API_KEY=
